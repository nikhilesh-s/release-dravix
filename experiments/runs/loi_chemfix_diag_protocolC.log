# ---- script
"""Diagnostic only (post-score): protocol C (GroupKFold by dominant FR class) for the r8d blend, all 10 repeats,
per held-out class and per blend member. Runs train_loi_rescore_r8.py up to ROUND 8 in a kept build tree, with the
exp089/exp092 repro fits stubbed out (they do not feed DATA)."""
import sys
from pathlib import Path

import numpy as np
import pandas as pd

w = Path(sys.argv[1])
src = (w / "data/v2/train_loi_rescore_r8.py").read_text()
src = src[:src.index("# ==== ROUND 8")]
for a, b in (("assert bm.sum() == 460 and df[bm].ref_id.nunique() == 83, (bm.sum(), df[bm].ref_id.nunique())", "pass"),
             ("assert len(y) == 460 and len(np.unique(g)) == 83", "pass"),
             ("B89, oof89 = ep.repeated_group_kfold(rf(), X89, y, g)", "B89, oof89 = np.zeros(10), np.zeros((10, len(y)))"),
             ("B92, oof92 = ep.repeated_group_kfold(rf(), DATA[\"c2\"][0], y, g)", "B92, oof92 = np.zeros(10), np.zeros((10, len(y)))")):
    assert src.count(a) == 1, a
    src = src.replace(a, b)
src = src.replace('not reproduced within 0.002; stopping.")\n    sys.exit(2)', 'stubbed")')
g = {"__file__": str(w / "data/v2/train_loi_rescore_r8.py"), "__name__": "diag"}
exec(compile(src, "prefix", "exec"), g)
X, y, dom = g["DATA"]["c2"][0], g["y"], g["dom"]
rid = g["df"][g["bm"]].row_id.to_numpy()
from sklearn.ensemble import ExtraTreesRegressor, RandomForestRegressor
from sklearn.impute import SimpleImputer
from sklearn.linear_model import Ridge
from sklearn.metrics import r2_score
from sklearn.model_selection import GroupKFold
from sklearn.pipeline import make_pipeline
from sklearn.preprocessing import StandardScaler

mk = {"rf": lambda: RandomForestRegressor(n_estimators=500, min_samples_leaf=2, random_state=0, n_jobs=-1),
      "et": lambda: ExtraTreesRegressor(n_estimators=500, min_samples_leaf=2, random_state=0, n_jobs=-1),
      "ridge": lambda: make_pipeline(SimpleImputer(strategy="median", add_indicator=True, keep_empty_features=True),
                                     StandardScaler(), Ridge(alpha=10.0))}
oof = {k: np.empty((10, len(y))) for k in mk}
for r in range(10):
    for tr, te in GroupKFold(n_splits=5, shuffle=True, random_state=r).split(X, y, dom):
        for k, f in mk.items():
            oof[k][r, te] = f().fit(X[tr], y[tr]).predict(X[te])
blend = (oof["rf"] + oof["et"] + oof["ridge"]) / 3
print(f"C blend mean {np.mean([r2_score(y, p) for p in blend]):.3f}; " +
      ", ".join(f"{k} {np.mean([r2_score(y, p) for p in oof[k]]):.3f}" for k in mk))
print("dom group sizes:", pd.Series(dom).value_counts().to_dict())
err = (blend - y) ** 2
t = pd.DataFrame(dict(dom=dom, se_blend=err.mean(0), se_ridge=((oof["ridge"] - y) ** 2).mean(0)))
print("share of blend SSE by held-out class:")
print((t.groupby("dom").se_blend.sum() / t.se_blend.sum()).sort_values(ascending=False).round(3).head(6).to_string())
i = np.argsort(-err.mean(0))[:8]
print("worst rows (row_id, dom, mean |blend err|, mean |ridge err|):")
for j in i:
    print(f"  {rid[j]:10s} {dom[j]:28s} {np.abs(blend[:, j] - y[j]).mean():8.2f} {np.abs(oof['ridge'][:, j] - y[j]).mean():8.2f}")
pd.DataFrame(dict(row_id=rid, dom=dom)).to_csv(sys.argv[2], index=False)
